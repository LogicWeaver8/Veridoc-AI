# Copy this file to `.env` in the repository root (or backend/.env) and adjust.
# Never commit real API keys or secrets. Values below are safe local defaults.

# --- Application ---------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api
# Comma-separated list of allowed browser origins. "*" is for local development.
CORS_ORIGINS=*

# --- Storage -------------------------------------------------------------
# Defaults to <repo>/data. Use an absolute path if you move storage elsewhere.
# DATA_DIR=C:/Users/you/veridox-data
# Override the database; defaults to SQLite at <DATA_DIR>/knowledge.db.
# DATABASE_URL=sqlite:///C:/Users/you/veridox-data/knowledge.db
MAX_UPLOAD_MB=25
MAX_BATCH_QUESTIONS=500

# --- Chunking ------------------------------------------------------------
CHUNK_SIZE_TOKENS=650
CHUNK_OVERLAP_TOKENS=90

# --- Embeddings ----------------------------------------------------------
# "hashing" is the offline default (no model download).
# "sentence-transformers" requires backend/requirements-ai.txt.
EMBEDDING_PROVIDER=hashing
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# "auto" uses FAISS when installed, otherwise the NumPy index.
VECTOR_BACKEND=auto

# --- Retrieval -----------------------------------------------------------
RETRIEVAL_CANDIDATES=15
FINAL_EVIDENCE_CHUNKS=6
RRF_K=60
MIN_VECTOR_SIMILARITY=0.10
MIN_ANSWER_SIMILARITY=0.20
RERANKER_ENABLED=false
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Language model ------------------------------------------------------
# mock | gemini | openai | ollama
# "mock" is an extractive, clearly labelled fallback. It is not a real LLM.
LLM_PROVIDER=mock
LLM_MODEL=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1

# --- OCR -----------------------------------------------------------------
OCR_ENABLED=true
OCR_MIN_CHARS_PER_PAGE=40

# --- Batch ---------------------------------------------------------------
BATCH_PROGRESS_COMMIT_EVERY=5
